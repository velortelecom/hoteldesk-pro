{
    "name": "velor-one",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "date-fns": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "validate:app": "npm run test -- --watch=false && npm run build",
    "qa:provision": "node scripts/provision-qa-data.mjs",
    "qa:isolation": "node scripts/verify-enterprise-isolation.mjs",
    "qa:verify-chef-role": "node scripts/verify-create-user-chef-role.mjs",
    "qa:e2e-smoke": "node scripts/e2e-enterprise-creation-isolation.mjs",
    "qa:functions-health": "node scripts/verify-edge-functions-runtime.mjs",
    "qa:db-health": "supabase db query --linked --file \"scripts/sql/qa_runtime_health.sql\"",
    "qa:backend-health": "npm run qa:functions-health && npm run qa:db-health",
    "qa:full": "npm run qa:verify-chef-role && npm run qa:e2e-smoke",
    "validate:mission": "npm run validate:app && npm run qa:backend-health && npm run qa:full",
    "validate:mission:ci": "npm run validate:app && npm run qa:functions-health"
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
