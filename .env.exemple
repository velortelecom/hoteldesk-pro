# =====================================================================
# CONFIGURATION LOCALE DE VELOR ONE
#
# Copiez ce fichier en « .env » a la racine du projet et remplacez les
# deux valeurs. Le .env est ignore par git (voir .gitignore) : il ne
# partira jamais dans un commit ni dans un bundle -- c'est pour ca qu'il
# ne se propage pas d'une machine a l'autre, et pourquoi il faut le
# recreer sur chaque poste.
#
# REDEMARREZ LE SERVEUR APRES L'AVOIR CREE.
#   Create React App ne lit ces variables qu'au demarrage. Un simple
#   rechargement de page, ou meme le rechargement a chaud du serveur, ne
#   les prendra PAS en compte : il faut couper (Ctrl+C) et relancer
#   « npm start ».
#
# OU TROUVER CES DEUX VALEURS
#   Tableau de bord Supabase -> votre projet -> Project Settings -> API
#     - « Project URL »        -> REACT_APP_SUPABASE_URL
#     - cle « anon » / public  -> REACT_APP_SUPABASE_ANON_KEY
#
#   La cle « anon » est PUBLIQUE par conception : elle est livree dans le
#   bundle du navigateur, donc lisible par n'importe quel visiteur. C'est
#   normal, ce sont les politiques RLS qui protegent les donnees.
#
#   Ne mettez JAMAIS la cle « service_role » ici. Elle contourne toutes
#   les politiques de securite, et tout ce qui est dans un fichier
#   REACT_APP_* se retrouve en clair dans le navigateur.
# =====================================================================

REACT_APP_SUPABASE_URL=https://votre-projet.supabase.co
REACT_APP_SUPABASE_ANON_KEY=votre-cle-anon

# ---------------------------------------------------------------------
# FACULTATIF -- L'ADRESSE DONNEE AUX UTILISATEURS
#
# Ces trois variables sont facultatives : laissees vides ou absentes,
# l'application retombe sur des valeurs qui FONCTIONNENT aujourd'hui
# (l'adresse Vercel en ligne, et une adresse de support qui recoit
# vraiment du courrier).
#
# A quoi elles servent : APP_URL s'affiche sur la carte remise au client
# quand on lui cree un compte, a cote de son mot de passe provisoire.
# C'est la premiere chose sur laquelle un nouvel utilisateur clique --
# elle doit ouvrir quelque chose.
#
# Le jour ou le domaine definitif est achete et branche sur Vercel :
# ajoutez REACT_APP_APP_URL dans les reglages du projet Vercel
# (Settings -> Environment Variables), redeployez, et c'est tout. Aucun
# code a modifier.
#
# Rappel : une variable CRA est lue au BUILD. Sur Vercel, l'ajouter ne
# suffit pas -- il faut relancer un deploiement pour qu'elle soit prise.
# ---------------------------------------------------------------------

# REACT_APP_APP_URL=https://app.exemple.fr
# REACT_APP_SUPPORT_EMAIL=support@exemple.fr
# REACT_APP_WEBSITE=https://exemple.fr
